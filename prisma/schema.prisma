// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Peta {
  id         String   @id @default(uuid())
  desa_id    String
  type       String
  properties Json
  geometry   Json
  createdAt  DateTime @default(now())
}

model Pekerjaan {
  id                     String   @id @default(uuid())
  rt                     Int
  rw                     Int
  umur                   Int
  jenis_kelamin          String
  status_pekerjaan_utama String
  bidang_pekerjaan       String
  nama_anggota           String
  id_keluarga            String   @default("KEL_BARU")
  nmdesa                 String   @default("Sidokepung")
  createdAt              DateTime @default(now())
}

model VillageTheme {
  id        String   @id @default(uuid())
  desa_name String   @unique
  themes    String[]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}


model DemografiDesa {
  id             String   @id @default(uuid())
  idkec          String
  kecamatan      String
  kode_desa      String
  iddesa         String   @unique
  nmdesa         String
  L              Int
  P              Int
  total_penduduk Int
  rjk            String
  kk_l           Int
  kk_p           Int
  total_kk       Int
  createdAt      DateTime @default(now())
}

model Umkm {
  id                                                     String   @id @default(uuid())
  kode                                                   String?
  nama                                                   String?
  rt                                                     String
  rw                                                     String
  dusun                                                  String?
  jml_ruta                                               Int      @default(0)
  jml_umkm                                               Int      @default(0)
  jml_umkm_kbli_a                                        Int      @default(0)
  jml_umkm_kbli_b                                        Int      @default(0)
  jml_umkm_kbli_c                                        Int      @default(0)
  jml_umkm_kbli_d                                        Int      @default(0)
  jml_umkm_kbli_e                                        Int      @default(0)
  jml_umkm_kbli_f                                        Int      @default(0)
  jml_umkm_kbli_g                                        Int      @default(0)
  jml_umkm_kbli_h                                        Int      @default(0)
  jml_umkm_kbli_i                                        Int      @default(0)
  jml_umkm_kbli_j                                        Int      @default(0)
  jml_umkm_kbli_k                                        Int      @default(0)
  jml_umkm_kbli_l                                        Int      @default(0)
  jml_umkm_kbli_m                                        Int      @default(0)
  jml_umkm_kbli_n                                        Int      @default(0)
  jml_umkm_kbli_o                                        Int      @default(0)
  jml_umkm_kbli_p                                        Int      @default(0)
  jml_umkm_kbli_q                                        Int      @default(0)
  jml_umkm_kbli_r                                        Int      @default(0)
  jml_umkm_kbli_s                                        Int      @default(0)
  jml_umkm_kbli_t                                        Int      @default(0)
  jml_umkm_kbli_u                                        Int      @default(0)
  jml_umkm_lokasi_bangunan_khusus_usaha                  Int      @default(0)
  jml_umkm_lokasi_bangunan_campuran                      Int      @default(0)
  jml_umkm_lokasi_kaki_lima                              Int      @default(0)
  jml_umkm_lokasi_keliling                               Int      @default(0)
  jml_umkm_lokasi_didalam_bangunan_tempat_tinggal_online Int      @default(0)
  jml_umkm_bentuk_pt_persero_sejenisnya                  Int      @default(0)
  jml_umkm_bentuk_ijin_desa_ijin_lainnya                 Int      @default(0)
  jml_umkm_bentuk_tidak_berbadan_hukum                   Int      @default(0)
  jml_umkm_skala_usaha_mikro                             Int      @default(0)
  jml_umkm_skala_usaha_kecil                             Int      @default(0)
  jml_umkm_skala_usaha_menengah                          Int      @default(0)
  nmdesa                                                 String   @default("Simoanginangin")
  createdAt                                              DateTime @default(now())
}
